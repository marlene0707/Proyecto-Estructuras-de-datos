import java.util.ArrayList;
import java.util.List;

public class MaxHeapDescuentos {

    private final List<Alimento> heap = new ArrayList<>();

    public void insertar(Alimento alimento) {

        if (alimento == null || alimento.calcularDescuento() <= 0
                || alimento.estaCaducado()) {
            return;
        }

        heap.add(alimento);
        subir(heap.size() - 1);
    }

    public Alimento obtenerMayorDescuento() {

        if (heap.isEmpty()) {
            return null;
        }

        return heap.get(0);
    }

    public Alimento extraerMayorDescuento() {

        if (heap.isEmpty()) {
            return null;
        }

        Alimento mayor = heap.get(0);
        Alimento ultimo = heap.remove(heap.size() - 1);

        if (!heap.isEmpty()) {
            heap.set(0, ultimo);
            bajar(0);
        }

        return mayor;
    }

    private int comparar(Alimento a, Alimento b) {

        int resultado = Integer.compare(
                a.calcularDescuento(),
                b.calcularDescuento()
        );

        if (resultado == 0) {
            return Long.compare(
                    b.diasParaCaducar(),
                    a.diasParaCaducar()
            );
        }

        return resultado;
    }

    private void subir(int indice) {

        while (indice > 0) {

            int padre = (indice - 1) / 2;

            if (comparar(heap.get(indice),
                    heap.get(padre)) <= 0) {
                break;
            }

            intercambiar(indice, padre);
            indice = padre;
        }
    }

    private void bajar(int indice) {

        int tamano = heap.size();

        while (true) {

            int izquierda = 2 * indice + 1;
            int derecha = 2 * indice + 2;
            int mayor = indice;

            if (izquierda < tamano &&
                    comparar(heap.get(izquierda),
                            heap.get(mayor)) > 0) {
                mayor = izquierda;
            }

            if (derecha < tamano &&
                    comparar(heap.get(derecha),
                            heap.get(mayor)) > 0) {
                mayor = derecha;
            }

            if (mayor == indice) {
                break;
            }

            intercambiar(indice, mayor);
            indice = mayor;
        }
    }

    private void intercambiar(int i, int j) {

        Alimento temporal = heap.get(i);
        heap.set(i, heap.get(j));
        heap.set(j, temporal);
    }

    public List<Alimento> obtenerOrdenados() {

        List<Alimento> copia = new ArrayList<>(heap);

        copia.sort((a, b) -> comparar(b, a));

        return copia;
    }

    public void limpiar() {
        heap.clear();
    }

    public boolean estaVacio() {
        return heap.isEmpty();
    }

    public int tamano() {
        return heap.size();
    }
}

