import java.util.ArrayList;
import java.util.List;

public class ListaDobleCompras {

    private class Nodo {

        String nombre;
        boolean comprado;

        Nodo anterior;
        Nodo siguiente;

        Nodo(String nombre) {
            this.nombre = nombre;
            this.comprado = false;
        }
    }

    private Nodo primero;
    private Nodo ultimo;

    public boolean agregar(String nombre) {

        if (nombre == null || nombre.trim().isEmpty()) {
            return false;
        }

        if (buscarNodo(nombre) != null) {
            return false;
        }

        Nodo nuevo = new Nodo(nombre.trim());

        if (primero == null) {

            primero = nuevo;
            ultimo = nuevo;

        } else {

            ultimo.siguiente = nuevo;
            nuevo.anterior = ultimo;

            ultimo = nuevo;
        }

        return true;
    }

    private Nodo buscarNodo(String nombre) {

        Nodo actual = primero;

        while (actual != null) {

            if (actual.nombre.equalsIgnoreCase(nombre.trim())) {
                return actual;
            }

            actual = actual.siguiente;
        }

        return null;
    }

    public boolean tachar(String nombre) {

        Nodo nodo = buscarNodo(nombre);

        if (nodo == null) {
            return false;
        }

        nodo.comprado = true;

        return true;
    }

    public boolean destachar(String nombre) {

        Nodo nodo = buscarNodo(nombre);

        if (nodo == null) {
            return false;
        }

        nodo.comprado = false;

        return true;
    }

    public boolean eliminar(String nombre) {

        Nodo nodo = buscarNodo(nombre);

        if (nodo == null) {
            return false;
        }

        if (nodo.anterior != null) {
            nodo.anterior.siguiente = nodo.siguiente;
        } else {
            primero = nodo.siguiente;
        }

        if (nodo.siguiente != null) {
            nodo.siguiente.anterior = nodo.anterior;
        } else {
            ultimo = nodo.anterior;
        }

        return true;
    }

    public List<String> obtenerTodos() {

        List<String> resultado = new ArrayList<>();

        Nodo actual = primero;

        while (actual != null) {

            String estado = actual.comprado
                    ? "[COMPRADO] "
                    : "[PENDIENTE] ";

            resultado.add(estado + actual.nombre);

            actual = actual.siguiente;
        }

        return resultado;
    }

    public int cantidadPendientes() {

        int cantidad = 0;

        Nodo actual = primero;

        while (actual != null) {

            if (!actual.comprado) {
                cantidad++;
            }

            actual = actual.siguiente;
        }

        return cantidad;
    }

    public int cantidadComprados() {

        int cantidad = 0;

        Nodo actual = primero;

        while (actual != null) {

            if (actual.comprado) {
                cantidad++;
            }

            actual = actual.siguiente;
        }

        return cantidad;
    }

    public boolean estaVacia() {
        return primero == null;
    }
}
