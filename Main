    private JPanel crearMenuLateral() {

        JPanel menu = new JPanel();
        menu.setPreferredSize(new Dimension(245, 0));
        menu.setBackground(Color.WHITE);
        menu.setLayout(new BorderLayout());

        JPanel superior = new JPanel();
        superior.setOpaque(false);
        superior.setLayout(new BoxLayout(
                superior, BoxLayout.Y_AXIS));

        superior.setBorder(
                new EmptyBorder(30, 18, 20, 18));

        JLabel logo = new JLabel("FreshStock");
        logo.setFont(new Font("SansSerif", Font.BOLD, 27));
        logo.setForeground(VERDE);

        JLabel descripcion = new JLabel(
                "SISTEMA INTELIGENTE DE INVENTARIO");

        descripcion.setFont(
                new Font("SansSerif", Font.BOLD, 9));

        descripcion.setForeground(GRIS);

        superior.add(logo);
        superior.add(Box.createVerticalStrut(5));
        superior.add(descripcion);
        superior.add(Box.createVerticalStrut(45));

        superior.add(crearBotonMenu(
                "  Panel principal", "DASHBOARD"));

        superior.add(Box.createVerticalStrut(10));

        superior.add(crearBotonMenu(
                "  Inventario", "INVENTARIO"));

        superior.add(Box.createVerticalStrut(10));

        superior.add(crearBotonMenu(
                "  Control de caducidades", "CADUCIDADES"));

        superior.add(Box.createVerticalStrut(10));

        superior.add(crearBotonMenu(
                "  Lista de compras", "COMPRAS"));

        superior.add(Box.createVerticalStrut(10));

        superior.add(crearBotonMenu(
                "  Ofertas inteligentes", "OFERTAS"));

        menu.add(superior, BorderLayout.NORTH);

        JPanel inferior = new JPanel();
        inferior.setOpaque(false);
        inferior.setBorder(
                new EmptyBorder(15, 18, 25, 18));

        inferior.setLayout(new BoxLayout(
                inferior, BoxLayout.Y_AXIS));

        JLabel version = new JLabel("FreshStock | Versión 2.0");
        version.setFont(
                new Font("SansSerif", Font.PLAIN, 11));

        version.setForeground(GRIS);

        inferior.add(version);
        menu.add(inferior, BorderLayout.SOUTH);

        menu.setBorder(
                BorderFactory.createMatteBorder(
                        0, 0, 0, 1, BORDE));

        return menu;
    }

    private JButton crearBotonMenu(
            String texto, String seccion) {

        JButton boton = new JButton(texto);

        boton.setFont(
                new Font("SansSerif", Font.BOLD, 13));

        boton.setHorizontalAlignment(SwingConstants.LEFT);
        boton.setForeground(TEXTO);
        boton.setBackground(Color.WHITE);
        boton.setBorder(new EmptyBorder(13, 12, 13, 12));
        boton.setFocusPainted(false);
        boton.setMaximumSize(new Dimension(210, 45));
        boton.setCursor(new Cursor(Cursor.HAND_CURSOR));
        boton.setAlignmentX(Component.LEFT_ALIGNMENT);
        boton.setOpaque(true);

        boton.addMouseListener(new MouseAdapter() {

            @Override
            public void mouseEntered(MouseEvent e) {
                boton.setBackground(VERDE_CLARO);
                boton.setForeground(VERDE);
            }

            @Override
            public void mouseExited(MouseEvent e) {
                boton.setBackground(Color.WHITE);
                boton.setForeground(TEXTO);
            }
        });

        boton.addActionListener(e -> {

            cardLayout.show(panelContenido, seccion);

            if (seccion.equals("CADUCIDADES")) {
                actualizarCaducidades();
            }

            if (seccion.equals("COMPRAS")) {
                actualizarListaCompras();
            }

            if (seccion.equals("INVENTARIO")) {
                actualizarTabla();
            }

            if (seccion.equals("OFERTAS")) {
                actualizarOfertas();
            }
        });

        return boton;
    }

