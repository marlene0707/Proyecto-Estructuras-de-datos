    // ==========================================
    // TARJETAS DE INDICADORES
    // ==========================================

    private JPanel crearTarjeta(
            String titulo,
            JLabel valor,
            String descripcion,
            Color color) {

        JPanel tarjeta = new JPanel(
                new BorderLayout(0, 12));

        tarjeta.setBackground(Color.WHITE);

        tarjeta.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(BORDE),
                new EmptyBorder(16, 16, 16, 16)));

        JPanel indicador = new JPanel();
        indicador.setBackground(color);
        indicador.setPreferredSize(new Dimension(5, 1));

        tarjeta.add(indicador, BorderLayout.WEST);

        JPanel contenido = new JPanel(
                new BorderLayout(0, 10));

        contenido.setOpaque(false);
        contenido.setBorder(
                new EmptyBorder(0, 10, 0, 0));

        JLabel etiqueta = new JLabel(titulo);

        etiqueta.setFont(
                new Font("SansSerif", Font.BOLD, 12));

        etiqueta.setForeground(GRIS);

        valor.setFont(
                new Font("SansSerif", Font.BOLD, 29));

        valor.setForeground(color);

        JLabel detalle = new JLabel(descripcion);

        detalle.setFont(
                new Font("SansSerif", Font.PLAIN, 11));

        detalle.setForeground(GRIS);

        contenido.add(etiqueta, BorderLayout.NORTH);
        contenido.add(valor, BorderLayout.CENTER);
        contenido.add(detalle, BorderLayout.SOUTH);

        tarjeta.add(contenido, BorderLayout.CENTER);

        return tarjeta;
    }

