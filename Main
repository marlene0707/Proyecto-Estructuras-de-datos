    private void construirInterfaz() {

        add(crearMenuLateral(), BorderLayout.WEST);

        cardLayout = new CardLayout();

        panelContenido = new JPanel(cardLayout);
        panelContenido.setBackground(FONDO);
        panelContenido.setBorder(
                new EmptyBorder(25, 25, 25, 25));

        panelDashboard = crearDashboard();
        panelInventario = crearInventario();
        panelCaducidades = crearCaducidades();
        panelCompras = crearCompras();
        panelOfertas = crearOfertas();

        panelContenido.add(panelDashboard, "DASHBOARD");
        panelContenido.add(panelInventario, "INVENTARIO");
        panelContenido.add(panelCaducidades, "CADUCIDADES");
        panelContenido.add(panelCompras, "COMPRAS");
        panelContenido.add(panelOfertas, "OFERTAS");

        add(panelContenido, BorderLayout.CENTER);

        cardLayout.show(panelContenido, "DASHBOARD");
    }

